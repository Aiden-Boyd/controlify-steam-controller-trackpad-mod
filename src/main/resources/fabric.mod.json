  "id": "steamtrackpads",
  "version": "${version}",
  "name": "Steam Controller Trackpads for Controlify",
  "description": "Dual trackpad controls for the newer Steam Controller through Controlify.",
  "authors": [
    "Community project"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.steampads.SteamTrackpadsClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.161.0",
    "controlify": "3.5.3+mc26.3"
  },
  "mixins": [
    "steamtrackpads.mixins.json"
  ]
}
